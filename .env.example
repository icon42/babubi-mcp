# Required: URL of your babubi instance
# Examples:
#   http://localhost:8000          (local install)
#   http://babubi:8000          (Docker service name on shared network)
#   https://babubi.example.com  (external URL)
BABUBI_URL=http://localhost:8000

# Required: API token from babubi web UI
# Go to Settings (top-right menu) > API Key, then copy the token
BABUBI_TOKEN=your-api-token-here

# MCP server transport: "http" for Docker/network clients, "stdio" for Claude Desktop
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Optional tuning
REQUEST_TIMEOUT=30.0
DEFAULT_PAGE_SIZE=100
